
# Application Configuration
PORT=                   # Port on which the application runs
APP_NAME=                 # Application name

# Database Configuration (PostgreSQL)
DB_HOST=           # Database server hostname
DB_PORT=                # PostgreSQL default port
DB_USERNAME=        # Database username
DB_PASSWORD=                 # Database password
DB_NAME=                  # Database name
DB_STATUS=      # Application database environment

# JWT Access Token Configuration
ACCESS_TOKEN_SECRETE=        # Secret key used to sign access tokens
ACCESS_TOKEN_EXPIREIN=   # Access token expiration time

# JWT Refresh Token Configuration
REFRSH_TOKEN_SECRETE=        # Secret key used to sign refresh tokens
REFRSH_TOKEN_EXPIREIN=7    # Refresh token expiration time

# Cookie Configuration
COOKIE_SECRET=               # Secret key used to sign cookies

# Redis Configuration
REDIS_HOST=         # Redis server hostname
REDIS_PORT=              # Redis default port
